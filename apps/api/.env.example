# API Environment Variables Example
PORT=5000
NODE_ENV=development

# Client / CORS Configuration
CLIENT_URL=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES=30d

# Supabase Configuration (PostgreSQL Database, Auth, and Storage)
# Required: Supabase project URL and service role key for database operations and storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration (Optional direct PostgreSQL connection string)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Twilio OTP Configuration (Twilio Verify API v2)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=your_twilio_phone

# Third-Party Services
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
RESEND_API_KEY=your_resend_api_key
